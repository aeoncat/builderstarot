DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://your-app-domain.com"
# Comma-separated emails allowed to view /admin/validation and exports.
OWNER_EMAILS="you@example.com"
# SMTP for transactional email (password resets). Titan/Hostinger example below.
# When unset, reset emails are logged to the server console instead of sent.
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_USER="noreply@your-app-domain.com"
SMTP_PASS="your-mailbox-password"
# Optional From header; defaults to "Builder's Tarot <SMTP_USER>".
SMTP_FROM="Builder's Tarot <noreply@your-app-domain.com>"
